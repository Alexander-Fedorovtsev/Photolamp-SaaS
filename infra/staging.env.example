# Copy to /opt/photolamp-test/.env ON THE SERVER. Never commit the filled file.
# Generate a URI-safe database password: openssl rand -hex 32
POSTGRES_USER=photolamp
POSTGRES_DB=photolamp
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
POSTGRES_RUNTIME_PASSWORD=GENERATED_AUTOMATICALLY_ON_FIRST_DEPLOY
# Both values are generated automatically on first deploy. Keep the complete
# keyring in an off-host password manager before relying on encrypted backups.
BACKUP_ACTIVE_KEY_ID=GENERATED_AUTOMATICALLY_ON_FIRST_DEPLOY
BACKUP_ENCRYPTION_KEYS=GENERATED_AUTOMATICALLY_ON_FIRST_DEPLOY
BACKUP_RETENTION_DAYS=30
BACKUP_RETENTION_COUNT=35
# Both values are generated automatically on first deploy. Preserve the complete
# keyring off-host before accepting real contacts.
CONTACT_ACTIVE_KEY_VERSION=GENERATED_AUTOMATICALLY_ON_FIRST_DEPLOY
CONTACT_ENCRYPTION_KEYS=GENERATED_AUTOMATICALLY_ON_FIRST_DEPLOY
TRAEFIK_CERT_RESOLVER=myresolver
# Generate with infra/scripts/generate-basic-auth.sh; preserve single quotes and $.
TRAEFIK_BASIC_AUTH_USERS='REPLACE_WITH_GENERATED_BCRYPT_LINE'
PHOTOLAMP_HEALTHCHECK_USER=photolamp
PHOTOLAMP_HEALTHCHECK_PASSWORD='REPLACE_WITH_BASIC_AUTH_PASSWORD'
HOLD_TTL_SECONDS=600
CHECKOUT_SESSION_TTL_SECONDS=1800
CHECKOUT_RATE_LIMIT_WINDOW_SECONDS=60
CHECKOUT_SESSION_RATE_LIMIT=10
CHECKOUT_MUTATION_RATE_LIMIT=10
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_RATE_LIMIT=3
OTP_VERIFY_RATE_LIMIT=10
CUSTOMER_SESSION_TTL_SECONDS=86400
STAFF_SESSION_TTL_SECONDS=43200
STAFF_INVITATION_TTL_SECONDS=172800
STAFF_AUTH_RATE_LIMIT=10
# This staging host remains limited to locked synthetic contacts.
# OTP_PEPPER=GENERATE_BEFORE_REAL_PHONE_LOOKUPS
