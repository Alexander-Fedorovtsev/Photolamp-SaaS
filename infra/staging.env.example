# Copy to /opt/photolamp-test/.env ON THE SERVER. Never commit the filled file.
# Generate a URI-safe database password: openssl rand -hex 32
POSTGRES_USER=photolamp
POSTGRES_DB=photolamp
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
TRAEFIK_CERT_RESOLVER=myresolver
# Generate with infra/scripts/generate-basic-auth.sh; preserve single quotes and $.
TRAEFIK_BASIC_AUTH_USERS='REPLACE_WITH_GENERATED_BCRYPT_LINE'
PHOTOLAMP_HEALTHCHECK_USER=photolamp
PHOTOLAMP_HEALTHCHECK_PASSWORD='REPLACE_WITH_BASIC_AUTH_PASSWORD'
