# Development only. Replace the database password before using shared infrastructure.
POSTGRES_USER=photolamp
POSTGRES_PASSWORD=local-development-only
POSTGRES_RUNTIME_PASSWORD=local-runtime-only
POSTGRES_DB=photolamp
APP_ENV=development
ENABLE_DEMO_PREVIEWS=true
HOLD_TTL_SECONDS=600
CHECKOUT_SESSION_TTL_SECONDS=1800
CHECKOUT_RATE_LIMIT_WINDOW_SECONDS=60
CHECKOUT_SESSION_RATE_LIMIT=10
CHECKOUT_MUTATION_RATE_LIMIT=10
SMS_PROVIDER_MODE=memory
OTP_PEPPER=local-synthetic-otp-pepper-change-me
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_RATE_LIMIT=3
OTP_VERIFY_RATE_LIMIT=10
CUSTOMER_SESSION_TTL_SECONDS=86400
# Native development (Compose overrides service hostnames internally).
DATABASE_URL=postgresql+asyncpg://photolamp_runtime:local-runtime-only@localhost:5432/photolamp
DATABASE_OWNER_URL=postgresql+asyncpg://photolamp:local-development-only@localhost:5432/photolamp
REDIS_URL=redis://localhost:6379/0
API_INTERNAL_URL=http://localhost:8000
