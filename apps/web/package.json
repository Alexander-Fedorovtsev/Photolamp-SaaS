    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.5.0",
    "typescript": "^5.8.0",
    "vitest": "5.0.3"
  },
  "type": "module"
